{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**/*)",
      "Edit(**/*)",
      "WebFetch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh search code:*)",
      "Bash(gh search issues:*)",
      "Bash(gh search prs:*)",
      "Bash(gh browse:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release download:*)",
      "Bash(gh gist view:*)",
      "Bash(gh gist list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh status:*)",
      "Bash(gh auth status:*)",
      "Bash(fd:*)",
      "Bash(sg:*)",
      "Bash(trash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(ln:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(date:*)",
      "Bash(env:*)",
      "Bash(make:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(pytest:*)",
      "Bash(cargo:*)",
      "Bash(swift:*)",
      "Bash(go:*)",
      "Bash(bundle:*)",
      "Bash(docker:*)",
      "Bash(pyenv:*)",
      "Bash(brew:*)",
      "Bash(export:*)",
      "Bash(ps:*)",
      "Bash(kill:*)",
      "Bash(command:*)",
      "Bash(magick:*)",
      "Bash(hugo:*)",
      "Bash(pwd:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(diff:*)",
      "Bash(uname:*)",
      "Bash(type:*)",
      "Bash(test:*)",
      "Bash([:*)",
      "Bash(true:*)",
      "Bash(false:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(tee:*)",
      "Bash(xargs:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(ruff:*)",
      "Bash(swiftc:*)",
      "Bash(xcrun:*)",
      "Bash(xcodebuild:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(convert:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(source:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.agent/tmp/**)",
      "Read(./.agents/tmp/**)",
      "Read(./.claude/tmp/**)",
      "Read(./.codex/tmp/**)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(pip:*)",
      "Bash(gh release create:*)",
      "Bash(gh gist create:*)",
      "Bash(gh workflow run:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/sdlc/hooks/agent-command-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": false,
  "skipAutoPermissionPrompt": false
}
