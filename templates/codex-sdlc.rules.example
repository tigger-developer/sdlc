# Managed by sdlc-install after explicit configuration confirmation.
# These rules reinforce commands prohibited by the default SDLC shell policy.

prefix_rule(
    pattern = ["rm"],
    decision = "forbidden",
    justification = "Use recoverable deletion such as trash; do not permanently delete through the agent shell.",
)

prefix_rule(
    pattern = ["sed"],
    decision = "forbidden",
    justification = "Use structure-aware editing or an explicit patch rather than sed.",
)

prefix_rule(
    pattern = ["awk"],
    decision = "forbidden",
    justification = "Use format-aware tools rather than awk for structured data or source changes.",
)

prefix_rule(
    pattern = ["source"],
    decision = "forbidden",
    justification = "Run explicit commands rather than sourcing arbitrary shell files.",
)

# BEGIN SDLC MANAGED PYTHON RULES
host_executable(
    name = "python",
    paths = ["/usr/bin/python", "/usr/local/bin/python", "/opt/homebrew/bin/python"],
)

host_executable(
    name = "python3",
    paths = ["/usr/bin/python3", "/usr/local/bin/python3", "/opt/homebrew/bin/python3"],
)

prefix_rule(
    pattern = ["python"],
    decision = "forbidden",
    justification = "Use the task-appropriate tool or a project-owned entry point rather than an ad hoc Python interpreter command.",
)

prefix_rule(
    pattern = ["python3"],
    decision = "forbidden",
    justification = "Use the task-appropriate tool or a project-owned entry point rather than an ad hoc Python interpreter command.",
)
# END SDLC MANAGED PYTHON RULES
